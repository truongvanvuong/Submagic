# ========================================================
# Sub Magic - Git Ignore Configuration
# ========================================================

# --------------------------------------------------------
# 1. Môi trường ảo Python & Package Cache
# --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments (Windows & Linux / WSL)
backend/.venv/
backend/.venv*/
.venv/
.venv*/
venv/
env/
ENV/

# --------------------------------------------------------
# 2. Frontend / Node.js
# --------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
frontend/.vite/

# Logs Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------------
# 3. Biến môi trường & Khóa bí mật (Secrets & API Keys)
# --------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.local
frontend/.env.*.local

# --------------------------------------------------------
# 4. Dữ liệu ứng dụng Sub Magic (Runtime Data & SQLite)
# --------------------------------------------------------
# Dữ liệu nội bộ sinh ra khi xử lý (video tải lên, crops, audio, exports)
backend/data/
data/

# Cơ sở dữ liệu SQLite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
*.db-wal
*.db-shm
*.db-journal

# --------------------------------------------------------
# 5. Model AI & Tệp Media dung lượng lớn
# --------------------------------------------------------
# Model Weights (Faster-Whisper, VietOCR, ONNX...)
*.bin
*.safetensors
*.onnx
*.pth
*.pt
*.h5
*.ckpt

# Video files (Tệp tải lên kiểm thử hoặc người dùng thêm)
*.mp4
*.mkv
*.avi
*.mov
*.wmv
*.flv
*.webm

# Audio files
*.wav
*.mp3
*.aac
*.flac
*.m4a
*.ogg

# --------------------------------------------------------
# 6. Kiểm thử & Cache (Testing & Caches)
# --------------------------------------------------------
/.pytest_cache/
.pytest_cache/
backend/.pytest_cache/
scripts/__pycache__/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --------------------------------------------------------
# 7. Tài liệu nhị phân dung lượng lớn
# --------------------------------------------------------
docs/*.pdf

# --------------------------------------------------------
# 8. IDE & Hệ điều hành (OS / Editor configs)
# --------------------------------------------------------
# Hệ điều hành
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Trình soạn thảo (VS Code, JetBrains...)
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Cấu hình Agent tạm thời
.agents/
